# ==============================================================================
# BACKEND FASTAPI ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
APP_NAME="Business Management API"
APP_ENV=production
DEBUG=false
API_V1_STR="/api/v1"

# Security & Authentication
# Generate strong secret key: `openssl rand -hex 32`
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Neon PostgreSQL Database Connection URL (Async Engine)
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.aws.neon.tech/neondb?ssl=require

# CORS Configuration (Allowed Origins)
BACKEND_CORS_ORIGINS=["https://your-frontend-app.onrender.com"]

# Security & Rate Limiting
ALLOWED_HOSTS=["*"]
RATE_LIMIT_PER_MINUTE=100
