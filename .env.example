# ==============================================================================
# ENTERPRISE BUSINESS MANAGEMENT SYSTEM - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and populate with production secrets before deployment.

# ------------------------------------------------------------------------------
# BACKEND FASTAPI CONFIGURATION
# ------------------------------------------------------------------------------
# Application Name
APP_NAME="Business Management API"

# Application Environment: 'production' or 'development'
APP_ENV=production

# Debug Mode: Must be 'false' in production (disables OpenAPI docs & detailed stack traces)
DEBUG=false

# API Route Prefix
API_V1_STR=/api/v1

# JWT Secret Key (Generate a strong 64-char random hex string using: `openssl rand -hex 32`)
SECRET_KEY=generate_a_secure_random_64_character_hex_secret_in_production

# Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (JSON array or comma-separated list of allowed frontend domain URLs)
BACKEND_CORS_ORIGINS=["https://your-frontend-app.onrender.com","https://yourcustomdomain.com"]

# Security Allowed Hosts
ALLOWED_HOSTS=["*"]
RATE_LIMIT_PER_MINUTE=100

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# Connection URL format for SQLAlchemy Async:
# postgresql+asyncpg://<username>:<password>@<ep-hostname>.neon.tech/<dbname>?ssl=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-example-pooler.c-3.aws.neon.tech/neondb?ssl=require

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# ------------------------------------------------------------------------------
# FRONTEND NEXT.JS CONFIGURATION
# ------------------------------------------------------------------------------
# Public Application Name shown in page headers
NEXT_PUBLIC_APP_NAME="Business Management System"

# Public API URL used by browser client to make REST requests
# Point this to your Render backend web service URL + /api/v1
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com/api/v1

# Server-Side API URL used by Next.js SSR server
SERVER_API_URL=https://your-backend-api.onrender.com/api/v1
